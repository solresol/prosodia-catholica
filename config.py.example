# Copy to config.py (gitignored) and fill in values.

# PostgreSQL
DB_HOST = "raksasa"
DB_PORT = 5432
DB_NAME = "herodian"
DB_USER = "herodian"
DB_PASSWORD = "CHANGE_ME"

# OpenAI
OPENAI_MODEL = "gpt-6-sol"
SUMMARY_MODEL = "gpt-5.6-luna"
GADGET_MODEL = "gpt-6-sol"

# Deployment (used by run_daily_pipeline.sh)
DEPLOY_HOST = "merah"
DEPLOY_PATH = "/var/www/vhosts/prosodia-catholica.symmachus.org/htdocs"

# Site generation
SITE_TITLE = "Prosodia Catholica (Herodian)"
SITE_CONTACT_NAME = ""  # Optional
SITE_CONTACT_EMAILS = ["gregb@ifost.org.au", "greg.baker@mq.edu.au", "greg.baker@anu.edu.au"]

# Staged cutover only after cloud rehearsal and readiness confirmation.
# Default legacy preserves the existing local gadget API call.
GADGET_WORKFLOW = "legacy"  # switch to "cloud" only at coordinated cutover
